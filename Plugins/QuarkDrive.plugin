[Script]
# > 夸克网盘 解锁SVIP
response if ${url} ~= /^https?:\/\/drive.*\.quark\.cn\/.+\/clouddrive\/(member.+|distribute\/detail.+|capacity\/growth\/info)/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/Quark.js") with tag="夸克网盘解锁SVIP", timeout=60, requires_body=true

[MITM]
hostname = drive*.quark.cn
