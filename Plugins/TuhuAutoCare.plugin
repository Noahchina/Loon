#!name=途虎养车
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://raw.githubusercontent.com/Noahchina/Loon/main/icons/tuhu.png
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/split/partT/tuhuyangche.lpx
#!tg-channel=https://t.me/inaisi
#!date=
#############################################

[Rule]
DOMAIN, analytics.tuhu.com, REJECT
DOMAIN, ta.tuhu.cn, REJECT




[Rewrite]
# 包含途虎小程序和App净化
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-cms\/circle\/recommend\//i then reject(404)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/[a-z-]+\/recommend/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-scene-marketing-service\/api\/scene\/queryScheme/i then reject(404)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mkt-push-message-box\/banner\/cms\/getIndexBanner/i then reject(404)
request if ${url} ~= /^https?:\/\/(mkt-)?gateway\.tuhu\.cn(\/mkt)?\/mlp-product-search-api\/search\/helper\/defaultAndHotWord/i then reject(404)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/beautyIndex\/getBeautyIndex/i then reject(404)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/ext-website-cl-beauty-api\/channelPage\/v\d\/channelPageCouponPromptComponent/i then reject(404)
request if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getAutoSuperConfig/i then reject(404)


[Script]
response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-common-api\/api\/personalCenter\/getCmsModuleList/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/TuhuRemoveAds.js") with tag="途虎养车去广告", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/[a-z-]+\/homePage\/getHomePageInfo/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/TuhuRemoveAds.js") with tag="途虎养车去广告", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/(cl-)?gateway\.tuhu\.cn(\/cl)?\/cl-shop-api\/shopTab\/getModuleForC/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/TuhuRemoveAds.js") with tag="途虎养车去广告", timeout=60, requires_body=true




[MITM]
hostname = mkt-gateway.tuhu.cn, cl-gateway.tuhu.cn, gateway.tuhu.cn