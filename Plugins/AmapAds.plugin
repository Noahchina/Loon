#!name=高德地图去广告@ddgksf2013
#!desc=应用净化
#!icon=https://raw.githubusercontent.com/Noahchina/Loon/main/icons/gaode.png
#!tag=ddgksf2013

[Rule]
DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT

[Rewrite]
# > 高德地图_开屏请求@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen/i then reject(200)
# > 高德地图_首页底部信息流@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\//i then reject_dict(200)
# > 高德地图_路线规划下方广告@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\?/i then reject_dict(200)
# > 高德地图_Tip请求@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information/i then reject(200)
# > 高德地图_通用广告请求@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution/i then reject(404)
# > 高德地图_搜索框scene@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend/i then reject_dict(200)
# > 高德地图_首页左上角gif@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif/i then reject_img(200)
# > 高德地图_左下天气@ddgksf2013
request if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather/i then reject_dict(200)

[Script]
# > 高德地图_amdc处理@ddgksf2013
response if ${url} ~= /^http:\/\/amdc\.m\.taobao\.com/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amdc.js") with tag="amdc", timeout=60, requires_body=true

# > 高德地图_底部tab栏角标@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_首页右中广告@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_附近页面@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_打车页面处理@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_首页底部处理@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_开屏广告@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_首页顶部推广@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_我的页面@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

# > 高德地图_搜索框热词@ddgksf2013
response if ${url} ~= /^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/amap.js") with tag="amap", timeout=60, requires_body=true

[MITM]
hostname = m5.amap.com, m5-zb.amap.com, center.amap.com, amap-aos-info-nogw.amap.com, ai.amap.com

