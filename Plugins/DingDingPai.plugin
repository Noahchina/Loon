#############################################

[Rule]
# 广告联盟已包含, REJECT


[Rewrite]
request if ${url} ~= /^https?:\/\/.*\.pglstatp-toutiao\.com\/.*ad.*/i then reject(404)
request if ${url} ~= /^https?:\/\/api\.htp\.ad-scope\.com\.cn.*/i then reject(404)
request if ${url} ~= /^https?:\/\/appgw\.ddpai\.com.*\/ad\/list.*/i then reject(404)
request if ${url} ~= /^https?:\/\/init\.sms\.mob\.com\/.*sdk\/init.*/i then reject(404)
request if ${url} ~= /^https?:\/\/apphw\.ddpai\.com:\d+\/onroad\/api\/v\d\/\w+\/list/i then reject_dict(200)




[MITM]
hostname = *.pglstatp-toutiao.com, api.htp.ad-scope.com.cn, appgw.ddpai.com, init.sms.mob.com, apphw.ddpai.com