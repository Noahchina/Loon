response if ${url} ~= /^https?:\/\/.+.xunlei.com\/(drive\/v1\/files|xluser.core.login\/v3\/getuserinfo)/i then script("https://raw.githubusercontent.com/Noahchina/Loon/main/Scripts/xunlei.js") with tag="迅雷Unlock", timeout=60, requires_body=true

[MITM]
